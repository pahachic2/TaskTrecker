{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "watch-api",
            "program": "dotnet",
            "args": [
                "watch",
                "run"
            ],
            "cwd": "${workspaceFolder}/GRAFF.TaskTracker.Api",
            "stopAtEntry": false,
            "console": "internalConsole",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "Web",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "watch-web",
            "program": "dotnet",
            "args": [
                "watch",
                "run"
            ],
            "cwd": "${workspaceFolder}/GRAFF.TaskTracker.Web",
            "stopAtEntry": false,
            "console": "internalConsole",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        }
    ]
} 