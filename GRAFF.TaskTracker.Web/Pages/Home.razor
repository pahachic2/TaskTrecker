@page "/"
@attribute [Authorize]
@using GRAFF.TaskTracker.Web.Models
@using GRAFF.TaskTracker.Web.Services
@inject IProjectService ProjectService
@inject NavigationManager NavigationManager

<PageTitle>Dashboard</PageTitle>

<h1>My Projects</h1>

@if (projects == null && isLoading)
{
    <p><em>Loading projects...</em></p>
}
else if (projects == null || !projects.Any())
{
    <p>No projects found. Create your first project!</p>
}
else
{
    <ul class="list-group">
        @foreach (var project in projects)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <a href="@($"projects/{project.ProjectId}")">@project.Name</a>
                <div>
                    @* Edit button can be added later *@
                    <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDeleteProject(project)">Delete</button>
                </div>
            </li>
        }
    </ul>
}

<hr />

<h3>Create New Project</h3>
<EditForm Model="@newProject" OnValidSubmit="HandleCreateProject">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label for="projectName">Project Name:</label>
        <InputText id="projectName" class="form-control" @bind-Value="newProject.Name" />
        <ValidationMessage For="@(() => newProject.Name)" />
    </div>

    <button type="submit" class="btn btn-primary" disabled="@isCreatingProject">
        @if (isCreatingProject) { <span class="spinner-border spinner-border-sm"></span> }
        Create Project
    </button>
    @if (!string.IsNullOrEmpty(createProjectError))
    {
        <div class="alert alert-danger mt-2">@createProjectError</div>
    }
</EditForm>

@if (projectToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                    <button type="button" class="close" @onclick="() => projectToDelete = null">
                        <span>&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete project "@projectToDelete.Name"? This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => projectToDelete = null">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="HandleDeleteProject" disabled="@isDeletingProject">
                        @if (isDeletingProject) { <span class="spinner-border spinner-border-sm"></span> }
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}


@code {
    private List<ProjectViewModel>? projects;
    private ProjectCreateDto newProject = new ProjectCreateDto();
    private bool isLoading = true;
    private bool isCreatingProject = false;
    private string? createProjectError;
    
    private ProjectViewModel? projectToDelete;
    private bool isDeletingProject = false;


    protected override async Task OnInitializedAsync()
    {
        await LoadProjects();
    }

    private async Task LoadProjects()
    {
        isLoading = true;
        projects = await ProjectService.GetProjects();
        isLoading = false;
    }

    private async Task HandleCreateProject()
    {
        isCreatingProject = true;
        createProjectError = null;
        var createdProject = await ProjectService.CreateProject(newProject);
        if (createdProject != null)
        {
            newProject = new ProjectCreateDto(); // Reset form
            await LoadProjects(); // Refresh list
        }
        else
        {
            createProjectError = "Failed to create project. Please try again.";
        }
        isCreatingProject = false;
    }
    
    private void ConfirmDeleteProject(ProjectViewModel project)
    {
        projectToDelete = project;
    }

    private async Task HandleDeleteProject()
    {
        if (projectToDelete == null) return;

        isDeletingProject = true;
        bool success = await ProjectService.DeleteProject(projectToDelete.ProjectId);
        if (success)
        {
            await LoadProjects(); // Refresh the list
        }
        else
        {
            // Optionally show an error message to the user
            Console.WriteLine($"Error deleting project {projectToDelete.Name}");
        }
        projectToDelete = null; // Close modal
        isDeletingProject = false;
    }
}
