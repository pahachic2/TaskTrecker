@if (taskToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete Task</h5>
                    <button type="button" class="close" @onclick="() => taskToDelete = null"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete task "@taskToDelete.Title"?</p>
                     @if (!string.IsNullOrEmpty(deleteTaskError))
                    {
                        <div class="alert alert-danger">@deleteTaskError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => taskToDelete = null">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="HandleDeleteTask" disabled="@isDeletingTask">
                         @if(isDeletingTask) { <span class="spinner-border spinner-border-sm"></span> }
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}
