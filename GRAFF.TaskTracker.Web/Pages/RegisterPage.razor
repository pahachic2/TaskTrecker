@page "/register"
@using GRAFF.TaskTracker.Web.Models // Using local DTOs
@using GRAFF.TaskTracker.Web.Services
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<h3>Register</h3>

@if (!string.IsNullOrEmpty(message))
{
    <div class="@(isError ? "alert alert-danger" : "alert alert-success")">@message</div>
}

<EditForm Model="@registerModel" OnValidSubmit="HandleRegistration">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label for="username">Username</label>
        <InputText id="username" class="form-control" @bind-Value="registerModel.Username" />
        <ValidationMessage For="@(() => registerModel.Username)" />
    </div>

    <div class="form-group">
        <label for="email">Email</label>
        <InputText id="email" type="email" class="form-control" @bind-Value="registerModel.Email" />
        <ValidationMessage For="@(() => registerModel.Email)" />
    </div>

    <div class="form-group">
        <label for="password">Password</label>
        <InputText id="password" type="password" class="form-control" @bind-Value="registerModel.Password" />
        <ValidationMessage For="@(() => registerModel.Password)" />
    </div>
    
    @* Optional: Confirm Password field can be added here *@

    <button type="submit" class="btn btn-primary" disabled="@isLoading">
         @if (isLoading) { <span class="spinner-border spinner-border-sm"></span> }
        Register
    </button>
    <NavLink href="login">Already have an account? Login here.</NavLink>
</EditForm>

@code {
    private RegisterModel registerModel = new RegisterModel();
    private string? message;
    private bool isError = false;
    private bool isLoading = false;

    private async Task HandleRegistration()
    {
        isLoading = true;
        message = null;
        isError = false;

        var result = await AuthService.Register(registerModel);
        if (result.Successful)
        {
            message = "Registration successful! Please login.";
            // Optionally redirect to login page after a delay or directly
            // NavigationManager.NavigateTo("/login");
        }
        else
        {
            message = result.ErrorMessage;
            isError = true;
        }
        isLoading = false;
    }
}
